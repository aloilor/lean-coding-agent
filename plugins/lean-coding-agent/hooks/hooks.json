{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/setup-lean-coding-agent/scripts/check-skill-updates.mjs\" --hook",
            "commandWindows": "powershell -NoProfile -Command \"& node (Join-Path $env:PLUGIN_ROOT 'skills/setup-lean-coding-agent/scripts/check-skill-updates.mjs') --hook\"",
            "timeout": 10,
            "statusMessage": "Checking for Lean Coding Agent updates"
          }
        ]
      }
    ]
  }
}
