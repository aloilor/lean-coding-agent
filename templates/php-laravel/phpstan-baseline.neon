# PHPStan ratchet baseline.
#
# This is the seed: empty, so a fresh project starts clean. Once the tools are
# installed, regenerate it against the current code to grandfather existing debt:
#
#     composer quality:baseline
#
# COMMIT this file. It is the ratchet — new code must pass clean, while listed
# (grandfathered) errors are tolerated until fixed. It is not an ephemeral
# artifact; the reviewer audits its diff for newly-suppressed findings.
parameters:
    ignoreErrors: []
